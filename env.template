# Deep Research Agent - Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM PROVIDER SELECTION
# =============================================================================
# Supported: openai, anthropic, vertex, gemini, ollama

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1

# =============================================================================
# OPENAI (if LLM_PROVIDER=openai)
# =============================================================================
# Get your key at: https://platform.openai.com/
# Models: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo

OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# ANTHROPIC (if LLM_PROVIDER=anthropic)
# =============================================================================
# Get your key at: https://console.anthropic.com/
# Models: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307

# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# GOOGLE VERTEX AI / GEMINI (if LLM_PROVIDER=vertex or gemini)
# =============================================================================
# Setup: https://cloud.google.com/vertex-ai/docs/start/cloud-environment
# Models: gemini-1.5-pro, gemini-1.5-flash, gemini-1.0-pro
# 
# Prerequisites:
# 1. Create a GCP project and enable Vertex AI API
# 2. Run: gcloud auth application-default login

# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1

# =============================================================================
# OLLAMA - LOCAL MODELS (if LLM_PROVIDER=ollama)
# =============================================================================
# Install Ollama: https://ollama.ai/
# Models: llama3, llama3:70b, mistral, mixtral, phi3
#
# Start Ollama server: ollama serve

# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# RESEARCH TOOLS (Required for all providers)
# =============================================================================

# Google Maps / Places API
# Get your key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Tavily Search API
# Get your key at: https://tavily.com/
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Research Settings
# MAX_RESEARCH_ITERATIONS=3
# COMPETITOR_SEARCH_RADIUS_MILES=2.0
# MAX_COMPETITORS=15

# Quality Thresholds
# MIN_QUALITY_SCORE=0.7

# Logging
# LOG_LEVEL=INFO
# LOG_TO_FILE=true
